<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>QJellyTower</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0436;CS0618</NoWarn>
  </PropertyGroup>

  <Target Name="CopyCustomOutput" AfterTargets="Build">
    <ItemGroup>
      <OutputDlls Include="$(OutputPath)\$(AssemblyName).dll" />
      <OutputDlls Include="$(OutputPath)\$(AssemblyName).pdb" />
    </ItemGroup>

    <MakeDir Directories="$(MSBuildProjectDirectory)\build" />
    <Copy SourceFiles="@(OutputDlls)" DestinationFolder="$(MSBuildProjectDirectory)\build" />
  </Target>

  <ItemGroup>
    <Content Include="Q弹尖塔\localization\zhs\settings_ui.json" />
    <Content Include="Q弹尖塔\localization\eng\settings_ui.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\..\dll依赖\beta特供\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>..\..\dll依赖\beta特供\BaseLib.dll</HintPath>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>..\..\dll依赖\beta特供\GodotSharp.dll</HintPath>
    </Reference>
    <Reference Include="sts2">
      <HintPath>..\..\dll依赖\beta特供\sts2.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
